# URL of your deployed Citizen Bank Core (no trailing slash)
CORE_API_URL=https://citizen-bank-core.vercel.app
# Set to false to hide the demo-profile hint on the sign-in page
NEXT_PUBLIC_SHOW_DEMO_LOGIN=true

# Website sign-in. The website's "Open the App" button lands on /sso, which asks Core to start the session.
# Setting this adds "Sign in with your Citizen account" to the login page (the website's sign-in page); leave empty to hide it.
NEXT_PUBLIC_SIGN_IN_URL=
# A short label shown in the corner of every page, for example: Demonstration: simulated money
NEXT_PUBLIC_DEMO_BANNER=
